{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "pill-id-the-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "height": "regular",
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Seed Pill ID Game post",
        "description": "Create the pinned starter post for the Pill ID game",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "pill_id_the_game_dev"
  }
}
